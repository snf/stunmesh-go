#!/usr/bin/env python3
"""Run after the owner's existing encrypted-volume unlock/mount script."""
import argparse
import json
import os
from pathlib import Path
import sys
from nas_common import KeyQuotaError,key_capacity,run,volume_guard

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check',action='store_true',help='verify prerequisites without starting services')
    args=parser.parse_args()
    if os.geteuid()==0: raise RuntimeError('run as operator, not host root')
    tools=Path('/srv/containers/service-tools')
    volume_guard(tools/'volume.json',['/srv/data/photos'])
    actual=Path('/exports/photos').stat();expected=Path('/srv/data/photos').stat()
    if (actual.st_dev,actual.st_ino)!=(expected.st_dev,expected.st_ino):
        raise RuntimeError('existing fotos bind mount does not match the unlocked volume')
    settings=Path('/srv/containers/syncthing-v2.settings.json')
    approved=json.loads(settings.read_text()).get('approved') is True
    key_capacity()
    running=run(['podman','ps','--format','{{.Names}}']).decode().splitlines()
    if approved and 'syncthing-v2' not in running:
        run([str(tools/'syncthing-service'),'check','--manifest',str(settings)])
    if args.check:
        print('Startup prerequisites verified; no services changed.')
        return
    # Capture Compose output: the legacy Samba command contains credentials.
    run(['podman','compose','-f','/srv/containers/samba-compose.yml','--in-pod=false','up','-d'])
    key_capacity()
    run(['podman-compose','-f','/srv/containers/stunmesh-audit-trial/compose.yml','up','-d'])
    running=run(['podman','ps','--format','{{.Names}}']).decode().splitlines()
    if approved and 'syncthing-v2' not in running:
        run([str(tools/'syncthing-service'),'start','--manifest',str(settings)])
    print('Samba/VPN started. Syncthing starts only with its approved manifest. Restic is not started here.')

if __name__=='__main__':
    try: main()
    except KeyQuotaError:
        print('start-services: insufficient keyring count/byte headroom; service startup stopped. Review /proc/key-users before retrying.',file=sys.stderr)
        sys.exit(1)
    except (RuntimeError,OSError,ValueError,KeyError):
        print('start-services: prerequisites or startup failed; inspect volume, bind mount, manifest and services through LAN. Command output withheld.',file=sys.stderr)
        sys.exit(1)
