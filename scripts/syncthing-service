#!/usr/bin/env python3
"""Guarded NAS production container; disabled until identities/mounts are approved."""
import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import sys
from nas_common import inactive,mount_argument,run,volume_guard

loader=importlib.machinery.SourceFileLoader('st_admin',str(Path(__file__).with_name('syncthing-admin')))
spec=importlib.util.spec_from_loader(loader.name,loader)
admin=importlib.util.module_from_spec(spec);loader.exec_module(admin)
NAME='syncthing-v2'

def validate(settings):
    if set(settings)!={'approved','role','config_root','state_dir','volume_record','enabled_folders','mounts','vpn_container'} or settings['approved'] is not True:
        raise RuntimeError('production remains disabled until the owner approves the directory/identity manifest')
    role=settings['role']
    if not isinstance(settings['enabled_folders'],list) or not settings['enabled_folders'] or len(set(settings['enabled_folders']))!=len(settings['enabled_folders']):
        raise RuntimeError('select nonempty, distinct folder IDs to activate')
    if not isinstance(settings['mounts'],dict) or not settings['mounts']:
        raise RuntimeError('explicit data mounts are required')
    for target,source in settings['mounts'].items():
        path=Path(target)
        if not path.is_absolute() or str(path)!=target or '..' in path.parts or path==Path('/') or any(path==reserved or path in reserved.parents or reserved in path.parents for reserved in map(Path,('/config','/state','/tmp','/proc','/sys','/dev','/etc','/bin','/usr','/run'))):
            raise RuntimeError('data mount overlaps a protected container path')
        if not Path(source).is_absolute(): raise RuntimeError('data mount source must be absolute')
    root=Path(settings['config_root']);state=Path(settings['state_dir'])
    if role=='nas' or settings['volume_record']:
        volume_guard(settings['volume_record'],[state]+list(settings['mounts'].values()))
    inactive([root/'config',state])
    tree=admin.harden(admin.load_xml(root/'config/config.xml'),listen_address='tcp://10.77.0.1:22000' if role=='nas' else '')
    plan=admin.inventory(json.loads((root/'inventory.json').read_text()),role)
    expected=plan['devices'];layout=plan['folders']
    own=admin.identity((root/'device-id.txt').read_text())
    if expected[role]!=own or len(tree.findall('device'))!=len(expected) or set(d.get('id') for d in tree.findall('device'))!=set(expected.values()):
        raise RuntimeError('native device inventory differs from the approved inventory')
    folders={f.get('id'):f for f in tree.findall('folder')}
    if len(tree.findall('folder'))!=len(layout) or set(folders)!=set(layout) or not set(settings['enabled_folders'])<=set(folders):
        raise RuntimeError('unexpected folder inventory')
    for fid,folder in folders.items():
        wanted=layout[fid]
        if folder.get('path')!=wanted['path'] or folder.get('type')!=wanted['type'] or set(d.get('id') for d in folder.findall('device'))!={expected[name] for name in wanted['devices']}:
            raise RuntimeError('folder path, direction or membership differs from approved inventory')
    for name,device_id in expected.items():
        device=next(d for d in tree.findall('device') if d.get('id')==device_id)
        admin.device_policy(device,role,name)
    for fid in settings['enabled_folders']:
        folder=folders[fid];inside=Path(folder.get('path',''))
        matches=[(target,source) for target,source in settings['mounts'].items() if inside==Path(target) or Path(target) in inside.parents]
        if len(matches)!=1: raise RuntimeError('folder has no unique bind mount')
        target,source=matches[0];host=Path(source)/inside.relative_to(target)
        if role=='nas' or settings['volume_record']: volume_guard(settings['volume_record'],[host])
        if not host.is_dir() or not (host/'.stfolder').is_dir():
            raise RuntimeError('approved source and its .stfolder marker must exist; no auto-creation')
        if not os.access(host,os.R_OK|os.W_OK|os.X_OK): raise RuntimeError('service user cannot access source')
        admin.set_text(folder,'paused','false')
    for device in tree.findall('device'): admin.set_text(device,'paused','false')
    return root,state,tree

def main():
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('action',choices=['check','start','stop'])
    p.add_argument('--manifest',required=True,type=Path);a=p.parse_args()
    if os.geteuid()==0: raise RuntimeError('run as operator, using rootless Podman')
    if a.action=='stop':
        run(['podman','stop','--time','30',NAME]);print('Stopped');return
    settings=json.loads(a.manifest.read_text());root,state,tree=validate(settings)
    args=['podman','run','-d','--name',NAME,'--network=container:'+settings['vpn_container'],'--group-add=keep-groups','--log-driver=none']+admin.args_for(root,state)
    for target,source in settings['mounts'].items(): args+=['--mount',mount_argument(source,target)]
    if a.action=='check': print('Volume, identities, selected folders and host-user access checked. Verify container UID/GID/ACL views before first activation.');return
    vpn=settings['vpn_container']
    if not isinstance(vpn,str) or not admin.re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}',vpn): raise RuntimeError('invalid VPN container name')
    if run(['podman','inspect','--format','{{.State.Running}}',vpn]).strip()!=b'true': raise RuntimeError('VPN container must already be running')
    if run(['podman','inspect','--format','{{.HostConfig.NetworkMode}}',vpn]).strip()==b'host': raise RuntimeError('shared host networking is not supported by this rootless workflow')
    # An existing namespace must actually contain a native WG interface.
    if not run(['podman','exec',vpn,'/usr/local/bin/wg','show','interfaces']).strip(): raise RuntimeError('VPN namespace has no WireGuard interface')
    if settings['role']!='nas':
        # Retained within this disposable namespace if WG is removed: the
        # private destination must never fall through to its underlay default.
        run(['podman','exec',vpn,'/bin/busybox','ip','route','replace','unreachable','10.77.0.1/32','metric','42777','proto','186'])
        route=run(['podman','exec',vpn,'/bin/busybox','ip','-4','route','get','10.77.0.1']).decode().split()
        interfaces=run(['podman','exec',vpn,'/usr/local/bin/wg','show','interfaces']).decode().split()
        if 'dev' not in route or route[route.index('dev')+1] not in interfaces:
            raise RuntimeError('NAS destination is not routed through WireGuard')
    admin.save(root/'config/config.xml',tree)
    run(args+[admin.IMAGE,'serve','--config=/config','--data=/state','--no-browser','--no-restart'])
    print('Started selected folders inside the VPN network namespace. No published ports; GUI disabled.')

if __name__=='__main__':
    try: main()
    except (RuntimeError,OSError,ValueError,KeyError) as error:
        print('syncthing-service: '+str(error),file=sys.stderr);sys.exit(1)
