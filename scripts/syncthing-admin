#!/usr/bin/env python3
"""Fresh native Syncthing identities, paused enrollment and temporary local GUI.
No custom sync protocol, daemon, discovery service or QR implementation.
"""
import argparse
import copy
import fcntl
import getpass
import hashlib
import json
import os
from pathlib import Path
import re
import sys
import xml.etree.ElementTree as ET

from nas_common import atomic,inactive,mount_argument,run,volume_guard

IMAGE='docker.io/syncthing/syncthing@sha256:397aa00b92b48d65540ea3ae3cbf271b87bdccbe07a0b7bd7d2debc3a7b29138'
DEVICE=re.compile(r'^[A-Z2-7]{7}(?:-[A-Z2-7]{7}){7}$')

def set_text(parent,name,text):
    values=parent.findall(name)
    for duplicate in values[1:]: parent.remove(duplicate)
    item=values[0] if values else ET.SubElement(parent,name)
    item.text=text
    return item

def load_xml(path):
    raw=path.read_bytes()
    if len(raw)>2*1024*1024 or b'<!DOCTYPE' in raw or b'<!ENTITY' in raw:
        raise RuntimeError('configuration XML outside supported bounds')
    root=ET.fromstring(raw)
    if root.tag!='configuration': raise RuntimeError('not a Syncthing configuration')
    return root

def harden(root,gui_enabled=False,listen_address=""):
    gui=root.find('gui');options=root.find('options')
    if gui is None or options is None or not gui.findtext('user') or not (gui.findtext('password') or '').startswith('$2'):
        raise RuntimeError('generate with a native authenticated GUI password first')
    gui.set('enabled','true' if gui_enabled else 'false')
    set_text(gui,'address','0.0.0.0:8384' if gui_enabled else '127.0.0.1:8384')
    for name in ('globalAnnounceEnabled','localAnnounceEnabled','relaysEnabled','natEnabled','startBrowser','crashReportingEnabled','upgradeToPreReleases'):
        set_text(options,name,'false')
    set_text(options,'urAccepted','-1');set_text(options,'autoUpgradeIntervalH','0')
    set_text(options,'listenAddress',listen_address)
    for folder in list(root.findall('folder')):
        if folder.get('id')=='default': root.remove(folder);continue
        set_text(folder,'paused','true')
        folder.set('rescanIntervalS','3600');folder.set('fsWatcherEnabled','true')
    for device in root.findall('device'):
        device.set('introducer','false');device.attrib.pop('autoAcceptFolders',None)
        set_text(device,'autoAcceptFolders','false')
        set_text(device,'paused','true')
    return root

def save(path,root):
    ET.indent(root)
    atomic(path,ET.tostring(root,encoding='utf-8',xml_declaration=True)+b'\n')

def identity(value):
    result=value.strip().upper()
    if not DEVICE.fullmatch(result): raise RuntimeError('invalid public device-ID shape; native Syncthing also verifies its checksum')
    return result

def inventory(value,role):
    """An explicit local inventory replaces device-count and folder templates."""
    if set(value)!={'devices','folders'} or not isinstance(value['devices'],dict) or not isinstance(value['folders'],dict):
        raise RuntimeError('inventory needs devices and folders mappings')
    devices=value['devices'];folders=value['folders']
    if 'nas' not in devices or role not in devices or len(devices)<2 or not folders:
        raise RuntimeError('inventory requires the NAS, local device and selected folders')
    if any(not re.fullmatch(r'[a-z][a-z0-9-]{0,31}',name) for name in devices):
        raise RuntimeError('invalid device label')
    ids={name:identity(device) for name,device in devices.items()}
    if len(set(ids.values()))!=len(ids): raise RuntimeError('device identities must be distinct')
    # Clients sync via the NAS, not directly with other phones/laptops.
    if role!='nas' and set(ids)!={'nas',role}:
        raise RuntimeError('client inventory must contain only itself and the NAS')
    paths=[]
    for fid,folder in folders.items():
        if not re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}',fid) or set(folder)!={'path','type','devices'}:
            raise RuntimeError('invalid folder inventory')
        path=Path(folder['path']);members=folder['devices']
        if not path.is_absolute() or str(path)!=folder['path'] or '..' in path.parts or path==Path('/'):
            raise RuntimeError('folder paths must be canonical absolute paths')
        if folder['type'] not in ('sendreceive','sendonly','receiveonly'):
            raise RuntimeError('unsupported folder direction')
        if not isinstance(members,list) or len(set(members))!=len(members) or not {role,'nas'}<=set(members) or not set(members)<=set(ids) or len(members)<2:
            raise RuntimeError('folder membership must explicitly include local device and NAS')
        if any(path==other or path in other.parents or other in path.parents for other in paths):
            raise RuntimeError('overlapping sync roots are not supported')
        paths.append(path)
    return {'devices':ids,'folders':folders}


def device_policy(device,role,name):
    # dynamic resolves to no addresses with both discovery mechanisms disabled:
    # the NAS passively accepts explicitly enrolled clients over its WG listener.
    set_text(device,'address','tcp://10.77.0.1:22000' if role!='nas' and name=='nas' else 'dynamic')
    set_text(device,'allowedNetwork','10.77.0.0/24')
    device.set('introducer','false')
    set_text(device,'autoAcceptFolders','false')


def pair(root,role,own,value):
    plan=inventory(value,role);ids=plan['devices']
    if ids[role]!=own: raise RuntimeError('inventory does not match the local native identity')
    previous={folder.get('id'):folder for folder in root.findall('folder')}
    for item in list(root.findall('device'))+list(root.findall('folder')): root.remove(item)
    for name,device_id in ids.items():
        device=ET.SubElement(root,'device',{'id':device_id,'name':name,'compression':'metadata'})
        device_policy(device,role,name)
    default=root.find('defaults/folder')
    for fid,settings in plan['folders'].items():
        # Adding a device must not discard an existing folder's versioning policy.
        source=previous.get(fid)
        if source is None: source=default
        folder=copy.deepcopy(source) if source is not None else ET.Element('folder')
        folder.attrib.update({'id':fid,'label':fid,'path':settings['path'],'type':settings['type'],
                              'rescanIntervalS':'3600','fsWatcherEnabled':'true','fsWatcherDelayS':'10'})
        for d in list(folder.findall('device')): folder.remove(d)
        for name in settings['devices']: ET.SubElement(folder,'device',{'id':ids[name]})
        set_text(folder,'paused','true');root.append(folder)
    return harden(root)

def args_for(root,state):
    return ['--rm','--pull=never','--userns=keep-id','--user',str(os.getuid())+':'+str(os.getgid()),
            '--cap-drop=all','--security-opt=no-new-privileges','--read-only','--umask=0077',
            '--no-healthcheck','--image-volume=ignore','--unsetenv=STHOMEDIR','--unsetenv=STGUIADDRESS',
            '--env','STNOUPGRADE=1',
            '--pids-limit=128','--entrypoint=/bin/syncthing',
            '--mount',mount_argument(root/'config','/config'),
            '--mount',mount_argument(state,'/state'),
            '--tmpfs','/tmp:rw,nosuid,nodev,noexec,size=16m']

def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action',choices=['generate','prepare','pair','start','stop','status'])
    parser.add_argument('--root',required=True,type=Path)
    parser.add_argument('--state-dir',type=Path)
    parser.add_argument('--volume-file',type=Path)
    parser.add_argument('--port',default=8384,type=int)
    parser.add_argument('--role',help='local inventory device label, e.g. nas or laptop')
    parser.add_argument('--inventory',type=Path,help='reviewed public device IDs and local folder memberships')
    a=parser.parse_args();os.umask(0o077)
    if os.geteuid()==0: raise RuntimeError('run as the rootless service user')
    root=a.root.resolve();state=(a.state_dir or root/'state').resolve()
    if str(root).startswith('/srv/') and not a.volume_file:
        raise RuntimeError('NAS operations require --volume-file and a large-volume state directory')
    if a.volume_file: volume_guard(a.volume_file,[state])
    name='syncthing-admin-'+hashlib.sha256(str(root).encode()).hexdigest()[:12]
    if a.action=='status':
        print(run(['podman','ps','--filter','name='+name,'--format','{{.Names}} {{.Status}} {{.Ports}}']).decode(),end='');return
    if a.action=='generate':
        if root.exists() or state.exists(): raise RuntimeError('refusing to reuse an identity or state directory')
        password=getpass.getpass('New local Syncthing GUI password: ')
        if len(password)<12 or '\n' in password: raise RuntimeError('use a password of at least 12 characters')
        (root/'config').mkdir(parents=True,mode=0o700);state.mkdir(parents=True,mode=0o700)
        run(['podman','run','-i','--network=none']+args_for(root,state)+[IMAGE,'generate','--config=/config','--data=/state','--no-port-probing','--gui-user=operator','--gui-password=-'],(password+'\n').encode())
        password=None
        public=run(['podman','run','--network=none']+args_for(root,state)+[IMAGE,'device-id','--config=/config','--data=/state']).decode().strip()
        atomic(root/'device-id.txt',(identity(public)+'\n').encode())
        save(root/'config/config.xml',harden(load_xml(root/'config/config.xml')))
        print('Fresh identity generated and disabled. Public ID: '+public);return
    if not root.is_dir() or not state.is_dir(): raise RuntimeError('configuration/state directory missing')
    lockfd=os.open(root/'.admin.lock',os.O_CREAT|os.O_WRONLY|os.O_NOFOLLOW,0o600)
    with os.fdopen(lockfd,'w') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        if a.action=='stop':
            names=run(['podman','ps','--format','{{.Names}}']).decode().splitlines()
            if name in names: run(['podman','stop','--time','30',name])
        inactive([root/'config',state])
        path=root/'config/config.xml';tree=harden(load_xml(path))
        if a.action=='pair':
            if not a.role or not a.inventory: raise RuntimeError('supply --role and --inventory')
            plan=inventory(json.loads(a.inventory.read_text()),a.role)
            tree=pair(tree,a.role,identity((root/'device-id.txt').read_text()),plan)
            atomic(root/'inventory.json',(json.dumps(plan,indent=2)+'\n').encode())
        save(path,tree)
        if a.action=='start':
            if not 1024<=a.port<=65535: raise RuntimeError('GUI port outside allowed range')
            tree=harden(tree,True);save(path,tree)
            try:
                run(['podman','run','-d','--name',name,'--network=pasta:--ipv4-only','-p','127.0.0.1:'+str(a.port)+':8384']+
                    args_for(root,state)+[IMAGE,'serve','--config=/config','--data=/state','--no-browser','--no-restart'])
            except BaseException:
                save(path,harden(tree));raise
            print('Temporary authenticated GUI: host 127.0.0.1:'+str(a.port)+'. No data mounts or sync-port publication.')
        else: print('Saved paused configuration; GUI disabled. No private key or API token exported.')

if __name__=='__main__':
    try: main()
    except (RuntimeError,OSError,ValueError,ET.ParseError) as error:
        print('syncthing-admin: '+str(error),file=sys.stderr);sys.exit(1)
