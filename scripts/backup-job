#!/usr/bin/env python3
"""One rootless Restic job; disabled until the separate cold-restore pilot passes."""
import argparse
import fcntl
import json
import os
from pathlib import Path,PurePosixPath
import stat
import sys
import time
from urllib.parse import urlsplit
from nas_common import mount_argument,run,volume_guard

# Official restic/restic 0.19.1, Linux/amd64 manifest, inspected 2026-09-23.
IMAGE='docker.io/restic/restic@sha256:08916bcda4a4435f9d9828ebb4e91bb7ada3d2c8a53699788930e0ae1bd4fa67'

def validate(settings):
    if settings.get('enabled') is not True: raise RuntimeError('backup disabled; no cloud operation attempted')
    if settings.get('metadata_reviewed') is not True: raise RuntimeError('review host/container UID/GID/ACL/xattr views before activation')
    repository=settings['repository']
    u=urlsplit(repository.removeprefix('s3:'))
    if not repository.startswith('s3:https://') or not u.hostname or u.username or u.password or u.query or u.fragment or not u.path.strip('/'):
        raise RuntimeError('configure an HTTPS S3 repository without embedded credentials')
    if settings['storage_class'] not in ('DEEP_ARCHIVE','STANDARD'): raise RuntimeError('unsupported storage class')
    sources=settings['sources']
    if not isinstance(sources,dict) or not sources or len(sources)>32: raise RuntimeError('select an explicit, nonempty source inventory')
    targets=[]
    for target,source in sources.items():
        path=PurePosixPath(target)
        if not target.startswith('/sources/') or '..' in path.parts or str(path)!=target or not Path(source).is_dir():
            raise RuntimeError('invalid or missing source bind')
        if any(path in other.parents or other in path.parents for other in targets): raise RuntimeError('overlapping backup targets')
        targets.append(path)
    volume_guard(settings['volume_record'],list(sources.values())+[settings['cache'],settings['state']])
    for name in ('cache','state'):
        if not Path(settings[name]).is_dir(): raise RuntimeError('create private large-volume working directories after mount verification')
    for name in ('password_file','credentials_file'):
        st=Path(settings[name]).lstat()
        if not stat.S_ISREG(st.st_mode) or st.st_mode&0o077 or st.st_uid!=os.getuid():
            raise RuntimeError('credential files must be owner-only regular files')
    return sources

def main():
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('action',choices=['run','check','status']);p.add_argument('--settings',type=Path,required=True);a=p.parse_args()
    s=json.loads(a.settings.read_text())
    if a.action=='status':
        stamp=Path(s['state'])/'last-success'
        if not stamp.exists(): print('No successful backup recorded. Enabled:',s['enabled']);return
        days=(time.time()-int(stamp.read_text().strip()))/86400
        print('Last success age: %.1f days; overdue: %s; enabled: %s'%(days,days>8,s['enabled']));return
    if os.geteuid()==0: raise RuntimeError('run as the rootless NAS service user')
    sources=validate(s)
    if a.action=='check': print('Configuration/mount guards passed; this does not replace a restore pilot.');return
    state=Path(s['state'])
    fd=os.open(state/'job.lock',os.O_CREAT|os.O_WRONLY|os.O_NOFOLLOW,0o600)
    with os.fdopen(fd,'w') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        worker=Path(__file__).resolve().parent/'restic-worker.sh'
        if not worker.is_file(): worker=Path(__file__).resolve().parents[1]/'deploy/restic/worker.sh'
        args=['podman','run','--rm','--name','restic-weekly','--pull=never','--network=pasta:--ipv4-only',
              '--userns=keep-id','--user',str(os.getuid())+':'+str(os.getgid()),'--group-add=keep-groups',
              '--cap-drop=all','--security-opt=no-new-privileges','--read-only','--pids-limit=128',
              '--entrypoint=/bin/sh','--tmpfs','/tmp:rw,nosuid,nodev,noexec,size=32m',
              '--mount',mount_argument(worker,'/backup/worker.sh',True),
              '--mount',mount_argument(s['password_file'],'/credentials/password',True),
              '--mount',mount_argument(s['credentials_file'],'/credentials/aws',True),
              '--mount',mount_argument(s['cache'],'/cache'),
              '--mount',mount_argument(s['state'],'/state')]
        for target,source in sources.items(): args+=['--mount',mount_argument(source,target,True)]
        env={'BACKUP_ENABLED':'1','RESTIC_REPOSITORY':s['repository'],'AWS_DEFAULT_REGION':s['region'],
             'RESTIC_PASSWORD_FILE':'/credentials/password','AWS_SHARED_CREDENTIALS_FILE':'/credentials/aws',
             'AWS_PROFILE':'restic','RESTIC_CACHE_DIR':'/cache','STORAGE_CLASS':s['storage_class']}
        for key,value in env.items(): args+=['--env',key+'='+value]
        # Keep Restic diagnostics in the owner's journal; no private contents in public reports.
        import subprocess
        result=subprocess.run(args+[IMAGE,'/backup/worker.sh'])
        if result.returncode: raise RuntimeError('backup/check failed; success timestamp was not advanced')

if __name__=='__main__':
    try: main()
    except (RuntimeError,OSError,ValueError,KeyError) as error:
        print('backup-job: '+str(error),file=sys.stderr);sys.exit(1)
