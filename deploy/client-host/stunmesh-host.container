[Unit]
Description=WireGuard direct service access
Requires=stunmesh-guard.service
After=stunmesh-guard.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Container]
Image=sha256:7203a28d29c83d4d64561c049bba967d9b96d2e3c7c1709c4626ff3cd0e764eb
Pull=never
ContainerName=stunmesh-host
Network=host
User=0:0
DropCapability=all
AddCapability=NET_ADMIN
NoNewPrivileges=true
ReadOnly=true
PidsLimit=128
Volume=/etc/stunmesh/laptop.json:/config/laptop.json:ro
Volume=/run/stunmesh-host:/ownership:rw
Tmpfs=/run:rw,nosuid,nodev,noexec,size=4m,mode=755
Entrypoint=/usr/local/bin/stunmesh-go
Exec=linux-run-owned /config/laptop.json

[Service]
RuntimeDirectory=stunmesh-host
RuntimeDirectoryMode=0700
ExecStartPre=/usr/local/libexec/stunmesh/vpn-client preflight
ExecStopPost=/usr/local/libexec/stunmesh/vpn-client cleanup
Restart=on-failure
RestartSec=15
TimeoutStopSec=30
